{
  // XKey (xkey.co.uk): free SEO & AI search check.
  "name": "xkey",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "routes": [
    { "pattern": "xkey.co.uk", "custom_domain": true },
    { "pattern": "www.xkey.co.uk", "custom_domain": true }
  ],
  "kv_namespaces": [{ "binding": "STATE", "id": "c677314f15644c22873e1098406a5c69" }],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true },
  // Browser scripts are served from Function#toString (src/index.js); keep_names would inject
  // __name() calls into them that break in the browser.
  "keep_names": false
}
